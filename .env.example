# IA — proveedores 100% gratis (sin tarjeta de crédito)

# Opción 1 — GitHub Models (recomendado si ya tienes GitHub)
# PAT con permiso Account → Models → Read
# https://github.com/settings/personal-access-tokens/new?user_models=read&name=FormuLab+AI
GITHUB_TOKEN=

# Opción 2 — Google Gemini (gratis en AI Studio)
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Opción 3 — Groq (gratis, muy rápido)
# https://console.groq.com/keys
GROQ_API_KEY=
