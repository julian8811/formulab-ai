# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Postgres (pooler transaction mode, puerto 6543 en Vercel)
# Obtener host correcto: npm run db:url
DATABASE_URL=postgresql://postgres.project-ref:password@aws-1-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# Supabase Management API (scripts setup/migrate)
SUPABASE_ACCESS_TOKEN=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
SETUP_SECRET=

# Modo demo local (sin Supabase)
# DEMO_MODE=true

# IA — proveedores gratis (sin tarjeta)
GITHUB_TOKEN=
GEMINI_API_KEY=
GROQ_API_KEY=
